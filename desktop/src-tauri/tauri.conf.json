{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctrl Room",
  "version": "0.1.0",
  "identifier": "app.openctrl.ctrlroom",
  "build": {
    "frontendDist": "https://www.openctrlroom.app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Community chat with rooms, threads, boards and voice and video calls.",
    "copyright": "Clayton Sinclair",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
