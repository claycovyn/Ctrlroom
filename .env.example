# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit (voice + video). Cloud: https://cloud.livekit.io, or self-host livekit-server.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public URL used in invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI helpers (@ctrl, @openctrl). Any OpenAI-compatible endpoint works, including open models:
#   Ollama   AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen2.5:14b
#   OpenRouter AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=meta-llama/llama-3.3-70b-instruct  AI_API_KEY=...
# Pick a model that supports tool calling. The service role key lets the server post answers; keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Web search for @ctrl: searxng (open source, self-hostable; enable the json format) or brave
SEARCH_PROVIDER=searxng
SEARXNG_URL=
BRAVE_API_KEY=

# ── OPENCTRL Cloud (leave all of this unset when you self-host: nothing is ever limited) ──
# Turns on the Free-tier limits from openctrl.json. Only the hosted OPENCTRL Cloud sets this.
CTRLROOM_CLOUD=
# SUPABASE_SERVICE_ROLE_KEY (above) is also needed for Cloud sync, call-minute metering, usage notices and /admin.
# Comma-separated emails that may open /admin (the account's email must be confirmed).
CTRLROOM_ADMIN_EMAILS=
# Usage notices (80% / 100%) through Resend. Email is off until both are set.
RESEND_API_KEY=
CTRLROOM_EMAIL_FROM="Ctrl Room <hello@example.com>"
CTRLROOM_SUPPORT_EMAIL=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to the daily /api/cron/usage job (vercel.json).
CRON_SECRET=
# Where "Join OPENCTRL Cloud" links point. Until set, the upgrade prompt says "Coming soon".
OPENCTRL_CLOUD_URL=
# Your fork, if you run a modified Ctrl Room for other people (AGPL section 13). /source redirects here.
CTRLROOM_SOURCE_URL=
